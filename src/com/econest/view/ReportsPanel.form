<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.econest.view.ReportsPanel">
  <grid id="27dc6" binding="panel1" default-binding="true" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="abe87">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="9db5f" class="javax.swing.JTextArea" binding="txtReportArea">
            <constraints/>
            <properties>
              <background color="-1246982"/>
              <foreground color="-16777216"/>
              <lineWrap value="true"/>
              <text value=""/>
              <wrapStyleWord value="false"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <grid id="54ce4" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="bdbe2" class="javax.swing.JButton" binding="btnGenerate">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="1" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font style="1"/>
              <hideActionText value="false"/>
              <text value="Generate Summary Report"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
